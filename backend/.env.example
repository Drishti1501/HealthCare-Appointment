DJANGO_SECRET_KEY=healthcare-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*
FRONTEND_URL=http://localhost:5173

# Email Settings (Defaults to Console backend if not configured)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Healthcare Platform <noreply@healthcare-manager.local>

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Google Calendar OAuth 2.0
GOOGLE_CALENDAR_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback/

# System Config
SLOT_HOLD_DURATION_MINUTES=10
